microsoft_saml_metadata_url = "https://login.microsoftonline.com/TENANT_ID/federationmetadata/2007-06/federationmetadata.xml"
cognito_domain_prefix       = "company-comparison-engine"

# Omit in AWS to select the latest Packer-built worker AMI by tags.
# Set an explicit AMI ID only when pinning or testing a specific image.
# worker_ami_id = "ami-0123456789abcdef0"

oauth_callback_urls = [
  "https://comparison.company.com/oauth/callback"
]

oauth_logout_urls = [
  "https://comparison.company.com/"
]

callback_clients = {
  client-production = {
    url = "https://client.company.com/jobs/completed"
  }
}
